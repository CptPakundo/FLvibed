// FLvibed.dll's version resource (Windows' file properties > Details); the numbers come from version.h.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FLV_VERSION_MAJOR, FLV_VERSION_MINOR, FLV_VERSION_PATCH, 0
PRODUCTVERSION FLV_VERSION_MAJOR, FLV_VERSION_MINOR, FLV_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FLvibed - controller, subtitles and movies for Freelancer"
            VALUE "FileVersion", FLV_VERSION
            VALUE "ProductName", "FLvibed"
            VALUE "ProductVersion", FLV_VERSION
            VALUE "OriginalFilename", "FLvibed.dll"
            VALUE "LegalCopyright", "Freelancer is (c) Microsoft; FLvibed is not affiliated with Microsoft"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
